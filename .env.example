# ==============================================================
# 3F FuturoForbes - Configuracion de Entorno
# Copia este archivo como .env y completa los valores
# ==============================================================

# Base de datos (SQLite por defecto, cambiar a PostgreSQL para produccion)
DATABASE_URL=sqlite:///3f_app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/3f_db

# Clave secreta para JWT (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# Servidor
PORT=8000
HOST=0.0.0.0

# Modo debug (False en produccion)
DEBUG_MODE=False

# Email (opcional, para recuperacion de contraseña)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASSWORD=tu_password

# Inteligencia Artificial (IA)
# Las integraciones con proveedores cloud (Gemini, OpenAI, etc.) se realizan
# mediante el sistema de plugins. Consulte docs/ia-plugin-contract.md.

# Tesseract OCR (motor OCR local ligero)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
